{
  "name": "@nooledit/chronicle",
  "version": "0.1.1",
  "private": true,
  "description": "Node native bindings for Chronicle's deterministic cron evaluator",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "napi build --platform",
    "test": "node --test test/*.cjs",
    "compare": "node ../benchmarks/differential.cjs",
    "benchmark": "node ../benchmarks/benchmark.cjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.1",
    "node-cron": "^4.2.1"
  },
  "napi": {
    "binaryName": "chronicle_node",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  }
}
