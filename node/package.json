{
  "name": "@nool/chronicle",
  "version": "0.3.0",
  "description": "A deterministic, node-cron-compatible scheduler with explicit DST policies",
  "main": "cron.js",
  "types": "cron.d.ts",
  "files": [
    "cron.js",
    "cron.d.ts",
    "scheduler.js",
    "index.js",
    "index.d.ts",
    "*.node",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "build": "napi build --platform",
    "test": "node --test test/*.cjs",
    "compare": "node ../benchmarks/differential.cjs",
    "benchmark": "node ../benchmarks/benchmark.cjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.1",
    "node-cron": "^4.2.1"
  },
  "optionalDependencies": {
    "@nool/chronicle-darwin-arm64": "0.3.0",
    "@nool/chronicle-darwin-x64": "0.3.0",
    "@nool/chronicle-linux-x64-gnu": "0.3.0",
    "@nool/chronicle-win32-x64-msvc": "0.3.0"
  },
  "napi": {
    "binaryName": "chronicle_node",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  }
}
