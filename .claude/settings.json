{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": ".nool/hooks/agent/claude_hook.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": ".nool/hooks/agent/claude_hook.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": ".nool/hooks/agent/claude_hook.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": ".nool/hooks/agent/claude_hook.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}
